// Backend Prisma Schema
// Note: Multi-Workspace, Multi-Team, TeamMember, MeetingNote, Summary, ActionItem, User

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum Provider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLE
  GITHUB
}

model User {
  id          Int         @id @default(autoincrement())
  uuid        String      @unique @default(uuid())
  name        String?
  username    String?     @unique
  email       String      @unique
  phone       String?
  password    String?
  avatar      String?
  role        Role        @default(USER)
  status      UserStatus  @default(PENDING)
  provider    Provider    @default(LOCAL)
  isVerified  Boolean     @default(false)
  lastLogin   DateTime?
  loginCount  Int         @default(0)
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime    @updatedAt

  loginHistory LoginHistory[]
  tokens       RefreshToken[]
  notes        MeetingNote[]
  memberships  TeamMember[]

  @@index([email])
  @@index([uuid])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revoked     Boolean  @default(false)
  userAgent   String?
  ipAddress   String?

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model LoginHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  device      String?
  browser     String?
  os          String?
  successful  Boolean  @default(true)
  message     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("login_history")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]
  notes       MeetingNote[]

  @@map("workspaces")
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  key         String   // e.g. ENG, PRD, DES
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  actionItems ActionItem[]
  notes       MeetingNote[]

  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  avatar    String?
  role      String   @default("MEMBER") // OWNER | LEAD | MEMBER
  createdAt DateTime @default(now())

  @@index([teamId])
  @@map("team_members")
}

model MeetingNote {
  id          String     @id @default(cuid())
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title       String
  content     String
  source      String     @default("manual") // manual | upload | ongoing
  fileName    String?
  fileSize    Int?
  status      String     @default("draft") // draft | summarized
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  summary     Summary?
  actionItems ActionItem[]

  @@index([userId])
  @@index([workspaceId])
  @@index([teamId])
  @@map("meeting_notes")
}

model Summary {
  id           String      @id @default(cuid())
  noteId       String      @unique
  note         MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  content      String
  keyPoints    String      // JSON string of string[]
  decisions    String      // JSON string of string[]
  participants String?     // JSON string of string[]
  sentiment    String      @default("neutral") // positive | neutral | negative
  wordCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("summaries")
}

model ActionItem {
  id          String       @id @default(cuid())
  noteId      String?
  note        MeetingNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title       String
  description String?
  assignee    String?
  dueDate     String?
  priority    String       @default("medium") // urgent | high | medium | low
  status      String       @default("todo") // backlog | todo | in_progress | done
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId])
  @@map("action_items")
}
