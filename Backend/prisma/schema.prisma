// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum Provider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLE
  GITHUB
}

model User {
  id          Int         @id @default(autoincrement())
  uuid        String      @unique @default(uuid())
  name        String?
  username    String?     @unique
  email       String      @unique
  phone       String?
  password    String?
  avatar      String?
  role        Role        @default(USER)
  status      UserStatus  @default(PENDING)
  provider    Provider    @default(LOCAL)
  isVerified  Boolean     @default(false)
  lastLogin   DateTime?
  loginCount  Int         @default(0)
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime    @updatedAt

  loginHistory LoginHistory[]
  tokens       RefreshToken[]
  notes        MeetingNote[]

  @@index([email])
  @@index([uuid])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revoked     Boolean  @default(false)
  userAgent   String?
  ipAddress   String?

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model LoginHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  device      String?
  browser     String?
  os          String?
  successful  Boolean  @default(true)
  message     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("login_history")
}

model MeetingNote {
  id          String   @id @default(cuid())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  content     String
  source      String   @default("manual") // manual | upload | ongoing
  fileName    String?
  fileSize    Int?
  status      String   @default("draft") // draft | summarized
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  summary     Summary?
  actionItems ActionItem[]

  @@index([userId])
  @@map("meeting_notes")
}

model Summary {
  id           String      @id @default(cuid())
  noteId       String      @unique
  note         MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  content      String
  keyPoints    String      // JSON string of string[]
  decisions    String      // JSON string of string[]
  participants String?     // JSON string of string[]
  sentiment    String      @default("neutral") // positive | neutral | negative
  wordCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("summaries")
}

model ActionItem {
  id         String       @id @default(cuid())
  noteId     String?
  note       MeetingNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)
  title      String
  assignee   String?
  dueDate    String?
  priority   String       @default("medium") // low | medium | high
  status     String       @default("pending") // pending | in_progress | completed
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("action_items")
}

